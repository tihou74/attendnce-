{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "**/.kiro/**",
      "**/tests/**",
      "**/*.md",
      "**/*.py",
      "**/*.pyc"
    ],
    "_why_no_cleanUrls": [
      "⚠️⚠️⚠️ لا تُضف cleanUrls ولا trailingSlash هنا أبدًا. أُضيفتا مرّةً",
      "بحجّة «روابط أنظف» (/admin بدل /admin.html) فعطّلتا لوحةَ المدراء",
      "تعطيلًا كاملًا: ERR_TOO_MANY_REDIRECTS على index.html?report=1 —",
      "أي أنّ المديرَ لا يستطيع الوصولَ إلى شاشته بحال.",
      "والسببُ أنّ هذا التطبيقَ مبنيٌّ على مساراتِ .html الصريحةِ في كلِّ موضع:",
      "  • العاملُ الخِدميُّ يحفظ سبعةَ مساراتٍ .html مسبقًا، واحتياطُه",
      "    cache.match('./index.html') — والتحويلُ يُفسد المطابقة.",
      "  • ستٌّ من ستٍّ من ملفّاتِ التعريف start_url تنتهي بـ.html، أي أنّ",
      "    **كلَّ أيقونةٍ مثبَّتةٍ على هاتفِ كلِّ موظفٍ** تشير إلى .html.",
      "  • ثلاثةَ عشرَ رابطًا داخليًّا تكتب .html، منها ./index.html?report=1",
      "    خمسَ مرّات — وهو بابُ المدراء.",
      "وiOS يحفظ الرابطَ الظاهرَ عند «إضافة إلى الشاشة الرئيسية» ويُسقط الـquery",
      "(مكتوبٌ في أعلى manager.html)، فالتحويلاتُ تضاعف ذلك العطلَ القديم.",
      "والقاعدة: يُقدَّم الموقعُ بنفسِ المساراتِ التي بُني عليها، بلا أيِّ تحويل.",
      "ويحرس هذا .github/scripts/check-hosting-paths.js فلا يعود بالنسيان."
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), geolocation=(self), microphone=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive, nosnippet"
          }
        ]
      },
      {
        "source": "**/*.@(js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|gif|svg|ico|mp4|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }
}
