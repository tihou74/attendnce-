rules_version = '2';

// =============================================================================
// Al Sheikha Group — Attendance & Payroll — Firestore Security Rules
//
//   >>>  RULES REVISION: v7   (2026-09-13)  <<<
//
// -----------------------------------------------------------------------------
// HOW TO TELL WHICH REVISION IS ACTUALLY LIVE ON THE SERVER
// -----------------------------------------------------------------------------
// Do NOT judge by this header alone. Instead, in the Firebase Console
// (Firestore Database -> Rules), click inside the editor, press Ctrl+F and
// search for:
//
//       isViewer
//
//   FOUND     -> v7 is live. Good.
//   NOT FOUND -> an OLDER revision is live. Select all (Ctrl+A), Delete,
//                paste this ENTIRE file, then click "Publish".
//                (Searching for an older marker such as financial_payments is
//                 not enough — always search for the newest collection added.)
//
// A missing collection shows up in the dashboard as:
//       "Error: Missing or insufficient permissions."
//
// -----------------------------------------------------------------------------
// REVISION HISTORY  —  ALWAYS bump the revision line above on EVERY change.
// -----------------------------------------------------------------------------
// If the revision line is not bumped, the header of an old published version
// looks IDENTICAL to the new file, so nobody can tell them apart in the
// console and the new rules are assumed to be live when they are not. That
// exact mistake happened with the "(v4)" label, which never changed across
// three different rule sets and caused a real "insufficient permissions"
// failure to go undiagnosed. Bump it every single time.
//
//   v7  2026-09-13  + isViewer()           (balances.html — READ-ONLY viewers,
//                                          excluded from isAdmin, limited to
//                                          settings/sales_reports/financial_payments)
//   v6  2026-09-13  + financial_months     (Close month / frozen snapshot)
//   v5  2026-09-13  + financial_payments   (Monthly Financial Report tab)
//   --  (unlabelled, still said v4)  + sales_reports  (Daily Sales Report)
//   v4  initial     + training_content, training_acknowledgments,
//                     role system (Admin/Accountant/Secretary) REMOVED
//
// -----------------------------------------------------------------------------
// How to deploy:
//   1) Firebase Console -> Firestore Database -> Rules tab
//   2) Click in the editor, press Ctrl+A then Delete (box must be EMPTY)
//   3) Paste this ENTIRE file
//   4) Click "Publish" (top right). It is greyed out when the text on screen
//      is identical to what is already live — that is why the revision line
//      above must change on every edit.
//
// Role system (Admin/Accountant/Secretary) has been REMOVED per request.
// Any user who can sign in with a valid email/password Firebase Auth
// account (i.e. any account you create in Firebase Console > Authentication
// > Users) gets full read/write access to every collection below — there is
// no more admin_users/{uid} lookup, no more field-level salary/otRate
// restriction. The only gatekeeping left is:
//   1) Firebase Authentication itself — only accounts you create can log in.
//   2) These rules require request.auth != null (and non-anonymous for the
//      admin dashboard) for every read/write, so unauthenticated internet
//      traffic still gets nothing.
// "Kiosk" = the index.html check-in/leave-request page, signed in
// ANONYMOUSLY. It keeps the same narrow, write-mostly access as before
// (create attendance/leave_requests, read employees/pins/geofences to
// populate its dropdowns and verify PINs, but no update/delete).
// =============================================================================

function isSignedIn() {
  return request.auth != null;
}

function isRealLogin() {
  return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

// -----------------------------------------------------------------------------
// VIEWERS — balances.html only, READ ONLY, and only three collections.
// -----------------------------------------------------------------------------
// These two people open balances.html to see the bank / delivery / cash figures
// and NOTHING else. A page with no buttons is not protection on its own: any
// email/password account used to be a full admin here, so they could simply
// open admin.html and change payroll. That is why the restriction lives in
// these rules and not only in the page.
//
// Consequences of being on this list, enforced server-side:
//   • READ  only settings, sales_reports and financial_payments — exactly what
//     the three balances are computed from.
//   • NO write, update or delete anywhere, ever.
//   • NO access at all to employees, salaries, attendance, deductions, QID
//     photos, warnings, leave requests, audit log or training records.
//
// The email must match EXACTLY the account created in
// Firebase Console > Authentication > Users. Create the accounts with these
// exact addresses — if an account is created with a different address it is
// NOT on this list and would be treated as a full admin instead.
function isViewer() {
  return isRealLogin() && request.auth.token.email in [
    'houti.anes@alsheikhagroup.qa',
    'fatima.alrumaihi@alsheikhagroup.qa'
  ];
}

// Any real admin-dashboard login (email/password) that is NOT on the viewer
// list, and NOT the kiosk's anonymous session. Such a user gets full access.
function isAdmin() {
  return isRealLogin() && !isViewer();
}

function isKiosk() {
  return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- employees --------------------------------------------------------
    match /employees/{empId} {
      allow read: if isAdmin() || isKiosk();
      allow create, update, delete: if isAdmin();
    }

    // ---- employee_pins ------------------------------------------------------
    match /employee_pins/{empId} {
      allow read: if isAdmin() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- deductions (dated deduction-day entries) ----------------------------
    match /deductions/{deductionId} {
      allow read, write: if isAdmin();
    }

    // ---- attendance ---------------------------------------------------------
    match /attendance/{logId} {
      allow read: if isAdmin() || isKiosk();
      allow create: if isAdmin() || isKiosk();
      allow update, delete: if isAdmin();
    }

    // ---- leave_requests -------------------------------------------------------
    match /leave_requests/{reqId} {
      allow read: if isAdmin();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---- employee_applications (self-registration by new hires from the
    // index.html kiosk page) ---------------------------------------------------
    // Kiosk (any visitor) can submit a new application, but can never read
    // the list back (so one applicant can't browse everyone else's QID
    // photos/phone numbers) and can never update/delete once submitted.
    // Only the admin dashboard can review, approve, or reject.
    match /employee_applications/{appId} {
      allow read: if isAdmin();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---- branch_geofences ---------------------------------------------------
    match /branch_geofences/{branchId} {
      allow read: if isAdmin() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- settings ------------------------------------------------------------
    // Holds financial_rates, cash_account (opening balances), salary_payouts and
    // cash_movements, plus the legacy single geofence doc if still present.
    // Viewers may READ (balances.html needs these four docs) but never write.
    match /settings/{docId} {
      allow read: if isAdmin() || isKiosk() || isViewer();
      allow write: if isAdmin();
    }

    // ---- employee_warnings (Warning Letters tab — admin-only; kiosk has no
    // access at all, since only the admin dashboard creates/reviews these) ---
    match /employee_warnings/{warnId} {
      allow read, write: if isAdmin();
    }

    // ---- annual_leaves (Annual Leaves tab — admin-only) ---------------------
    match /annual_leaves/{leaveId} {
      allow read, write: if isAdmin();
    }

    // ---- allowance_payments (linked leave/ticket allowance payouts created
    // automatically when an Annual Leave is saved — admin-only, same as the
    // deductions/annual_leaves collections it is tied to) --------------------
    match /allowance_payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // ---- admin_users (legacy collection from the old role system — no
    // longer used by the app, kept locked down in case old docs linger) -----
    match /admin_users/{uid} {
      allow read, write: if isAdmin();
    }

    // ---- audit_log (read-only trail of key mutating actions — admin-only
    // read/create, NO update/delete allowed for anyone, keeping the log
    // immutable/tamper-resistant once written) -------------------------------
    match /audit_log/{entryId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ---- training_content (the daily work guide/protocol text+images per
    // restaurant+department, doc id = {RESTAURANT}__{DEPARTMENT}) -----------
    // The kiosk (Employee Training tab) only ever needs to READ this to show
    // it to the employee; only the admin dashboard's Training Content editor
    // ever writes it.
    match /training_content/{docId} {
      allow read: if isAdmin() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- training_acknowledgments (permanent proof an employee confirmed
    // reading the training guide) --------------------------------------------
    // The kiosk creates one on each confirmation (and re-reads its own
    // history to show the "already confirmed" banner isn't strictly needed
    // server-side, but allowing isKiosk() read here keeps that banner
    // working without a separate admin-only round trip). Only the admin
    // dashboard's Training Records view otherwise reads these. NO update/
    // delete for anyone — this must stay a permanent, tamper-resistant audit
    // trail, exactly like audit_log above.
    match /training_acknowledgments/{ackId} {
      allow read: if isAdmin() || isKiosk();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if false;
    }

    // ---- financial_months (one doc per closed month, id = 'YYYY-MM') --------
    // Holds the frozen snapshot of a month's financial figures once management
    // closes it, so a past month can never be silently recalculated by a later
    // salary edit or employee deletion. Admin-only in both directions: the
    // kiosk has no reason to read or write an accounting record.
    match /financial_months/{monthId} {
      allow read, write: if isAdmin();
    }

    // ---- financial_payments (the fixed/variable payment lines that feed the
    // Monthly Financial Report tab in the admin dashboard) -------------------
    // Admin-only in BOTH directions. Unlike sales_reports the kiosk has no
    // reason to even create these: rent, salaries and purchase figures are
    // entered by management on the dashboard, never from the employee page.
    // Viewers may READ these (money going out is part of the balance) but can
    // never add, change or delete a payment.
    match /financial_payments/{paymentId} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    // ---- sales_reports (the Daily Sales Report a branch manager submits from
    // the managers-only #report screen in index.html) ------------------------
    // The kiosk page may CREATE a report but can NEVER read one back. Sales
    // figures are commercially sensitive and index.html is signed in
    // ANONYMOUSLY, so granting it read access here would expose every branch's
    // revenue to anyone who can open that page. Managers therefore submit
    // "blind" and only get a confirmation message; the figures are readable
    // exclusively from the admin dashboard's Daily Report tab.
    // Update is admin-only as well: a manager who mistyped simply submits
    // again, and the admin deletes the wrong entry — this also means a
    // malicious anonymous caller cannot overwrite a real report it cannot read.
    // Viewers may READ these (money coming in is part of the balance) but can
    // never submit, change or delete a report.
    match /sales_reports/{reportId} {
      allow read: if isAdmin() || isViewer();
      allow update, delete: if isAdmin();
      allow create: if isKiosk() || isAdmin();
    }

    // ---- Default deny for anything not explicitly listed above ---------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
