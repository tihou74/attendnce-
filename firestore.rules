rules_version = '2';

// =============================================================================
// Al Sheikha Group — Attendance & Payroll — Firestore Security Rules
//
//   >>>  RULES REVISION: v17   (2026-09-24)  <<<
//
// -----------------------------------------------------------------------------
// HOW TO TELL WHICH REVISION IS ACTUALLY LIVE ON THE SERVER
// -----------------------------------------------------------------------------
// Do NOT judge by this header alone. Instead, in the Firebase Console
// (Firestore Database -> Rules), click inside the editor, press Ctrl+F and
// search for:
//
//       abaya_presence
//
//   (This exact text exists nowhere in any earlier revision, which is the whole
//    point of a marker. Every earlier marker is now useless for telling the
//    latest revision apart, and that is normal — each one only ever works for
//    the single revision that introduced it:
//      "abaya_sales_reports"        is in v11 AND v12  -> never worked
//      "isAccountant() || isViewer();" predates the abaya work -> never worked
//      "abaya-balances.html"        introduced in v12, still here in v13/v14/v15
//      "manager_presence"           introduced in v13, still here in v14/v15
//      "supervisor_presence"        introduced in v14, still here in v15
//    Always search for the marker named directly above, and when publishing a
//    new revision, change that name to something introduced by it.)
//
//   FOUND     -> v15 is live. Good.
//   NOT FOUND -> an OLDER revision is live. Select all (Ctrl+A), Delete,
//                paste this ENTIRE file, then click "Publish".
//                (Searching for an older marker such as financial_payments is
//                 not enough — always search for the newest collection added.)
//
// A missing collection shows up in the dashboard as:
//       "Error: Missing or insufficient permissions."
//
// -----------------------------------------------------------------------------
// REVISION HISTORY  —  ALWAYS bump the revision line above on EVERY change.
// -----------------------------------------------------------------------------
// If the revision line is not bumped, the header of an old published version
// looks IDENTICAL to the new file, so nobody can tell them apart in the
// console and the new rules are assumed to be live when they are not. That
// exact mistake happened with the "(v4)" label, which never changed across
// three different rule sets and caused a real "insufficient permissions"
// failure to go undiagnosed. Bump it every single time.
//
//  v17  2026-09-24  + SIZES AVAILABLE (خانة السيز المتوفر), requested right after
//                     v16 and never published separately — publish v17 instead.
//                     A `size` field now rides on abaya_products (it is NOT a
//                     secret: it is the first thing a customer asks and the
//                     saleswoman must read it), and the viewer's update key list
//                     gains 'size'. That is deliberate and is the ONLY widening:
//                     a second shipment of the same barcode routinely arrives in
//                     different sizes, and without it the catalogue's size line
//                     would go stale with no way for her to correct it. A size
//                     carries no money and cannot be confused with a price.
//                     ⚠️ 'price' is STILL absent from every grant of hers.
//
//  v16  2026-09-24  + NEW GOODS ARRIVED — abaya_arrivals + abaya_arrival_images,
//                     and THE FIRST WRITE ACCESS MRS FATIMA HAS EVER HAD.
//
//                     ⚠️⚠️⚠️ READ THIS BEFORE PUBLISHING. Until this revision the
//                     VIEWERS could write NOTHING, ANYWHERE — that was stated as
//                     an absolute in this file and it is now no longer true. The
//                     owner asked for a flow where he records an arriving
//                     shipment with its purchase figures, and MRS FATIMA chooses
//                     which shop it goes to and SETS THE SELLING PRICE, after
//                     which it becomes a catalogue line by itself. There is no
//                     backend in this project and no Cloud Functions, so "by
//                     itself" can only mean HER BROWSER performs those writes.
//                     A screen cannot be trusted to limit them — these rules do.
//
//                     What she may now do, and nothing beyond it:
//                       • abaya_arrivals   — update ONLY the six dispatch fields,
//                         and only while the shipment is still 'waiting'. She can
//                         never touch a purchase figure (USD, shipping, labour,
//                         supplier, cost) and can never dispatch the same
//                         shipment twice, which would double the stock.
//                       • abaya_products   — CREATE a design (that is where her
//                         selling price is set), and UPDATE only ['qty',
//                         'updatedAt'] exactly like the kiosk. So restocking an
//                         existing design adds pieces and CANNOT change its
//                         price. Changing the price of something already on a
//                         shelf stays the owner's, through the WhatsApp request
//                         her panel already has.
//                       • abaya_product_costs / abaya_product_images — write, so
//                         the shipment's cost and its photograph carry onto the
//                         new catalogue line without the owner re-entering them.
//                       • abaya_product_moves — create, so the pieces she sends
//                         appear in "what moved and who moved it" under her name.
//
//                     The KIOSK is granted NOTHING here. abaya_arrivals holds our
//                     purchase price, our shipping and our supplier's name, and
//                     the kiosk signs in ANONYMOUSLY — which in practice means
//                     anyone holding the saleswoman's link. Never add isKiosk()
//                     to these two collections.
//
//  v15  2026-09-17  + THE SALESWOMEN'S BOARD — abaya_seller_cards + abaya_presence.
//                     Management's request: when a saleswoman signs in at a shop,
//                     her photograph appears in the Al Sheikha Style window of the
//                     viewing panel with a short English sentence saying who she
//                     is and which shop she is in. When she presses Check-Out she
//                     disappears from the board completely — the owner asked for
//                     that explicitly, so the screen does not become crowded with
//                     people who have already gone home.
//                     Built exactly like v14's mirror: her punch on her own
//                     screen is unchanged, and a small copy is written at the same
//                     moment (name, shop, in or out, time). No location — her
//                     punch deliberately has none.
//                     TWO NEW COLLECTIONS RATHER THAN REUSING v13/v14's:
//                     the owner's instruction was absolute — "the saleswomen have
//                     nothing to do with the restaurants, I do not want even a
//                     smell of them in the restaurants, and the other way round".
//                     Putting their documents inside manager_cards and
//                     supervisor_presence is that mixing, and it would then rely
//                     on every reader remembering to filter; one forgotten filter
//                     puts a saleswoman on the managers' board. Separate
//                     collections cannot mix by accident. That is the whole reason
//                     this revision exists and has to be published.
//                     Nothing about the restaurants changed in this revision. The
//                     four blocks above (attendance, manager_cards,
//                     manager_presence, supervisor_presence) are byte-identical to
//                     v14.
//
//  v14  2026-09-16  + THE SUPERVISORS' BOARD — supervisor_presence.
//                     Management's request: a fourth window in the viewing panel
//                     showing which supervisors are at work right now, each with
//                     his photo and a green or red dot, laid out like the
//                     managers' board.
//                     The important difference from v13: a supervisor does NOT
//                     declare anything. He clocks in on the staff attendance page
//                     exactly as before, with his PIN and the location check, and
//                     this collection is a small MIRROR of that punch written at
//                     the same moment — the name, the branch, in or out, and the
//                     time. Nothing else.
//                     Why a mirror instead of simply letting the viewers read
//                     `attendance`: that collection carries EVERY employee's
//                     complete history and the GPS coordinates of every punch,
//                     and Firestore cannot hide some rows or some fields on a
//                     read. The owner was asked and said no. So attendance stays
//                     closed to viewers — deliberately unchanged in this
//                     revision — and the mirror carries only what the board
//                     needs and no location at all.
//                     Append-only for the kiosk, exactly like manager_presence:
//                     the staff page signs in anonymously, so update permission
//                     would let anyone with that link rewrite a record. The
//                     current state of a supervisor is his latest event that day.
//                     No viewer gains any write anywhere, as always.
//                     The photo and job title come from manager_cards, which
//                     viewers may already read and which now serves supervisors
//                     too — it holds only a name, a branch, a title and a small
//                     picture, nothing confidential. It still must NEVER hold a
//                     QID image.
//  v13  2026-09-15  + MANAGERS' PRESENCE — manager_presence and manager_cards.
//                     Management's request: Mrs Fatima opens the panel and sees
//                     which managers are on duty at that moment, each with his
//                     photo, a green/red dot and a short written message.
//                     Two NEW collections on purpose, and specifically NOT the
//                     existing attendance collection:
//                       • attendance feeds PAYROLL. A presence record written
//                         there would change salaries, and would also break the
//                         kiosk's strict Check-In/Check-Out alternation, since
//                         the kiosk reads an employee's newest attendance doc
//                         regardless of its type. Management was explicit that
//                         the managers' hours are NOT being measured here
//                         ("لا يهمني مدة العمل") — so this data must stay out of
//                         payroll entirely.
//                       • the VIEWERS cannot read employees at all (salaries,
//                         QID photos), so the manager's photo and name could
//                         not have come from an employee document. manager_cards
//                         holds ONLY a name, a branch, a job title and a small
//                         photo — nothing confidential — which is why a viewer
//                         may read it while employees stays closed to her.
//                     manager_presence is APPEND-ONLY for the managers' screen:
//                     it records events (start / end / off) and the current
//                     state is the latest event of that day. Nobody may edit an
//                     event after the fact; the owner alone may delete one, to
//                     clear a test entry. A manager who pressed the wrong button
//                     simply presses the right one — the newest event wins.
//                     No viewer gains any write anywhere, as always.
//  v12  2026-09-15    abaya_sales_reports: the VIEWERS (the owner's viewing
//                     account and Mrs Fatima) may now READ them, for the new
//                     read-only page abaya-balances.html which shows the abaya
//                     account, the daily target and the stock.
//                     This REVERSES part of v11 on purpose: v11 limited the
//                     abaya business to the owner and the accountant, and the
//                     owner has since asked for Mrs Fatima to see it. Read
//                     only — viewers still have no write anywhere at all, so
//                     they cannot submit, correct or delete a report, add a
//                     saleswoman, or change the rates, targets or stock count.
//                     settings/abaya_targets needs no rule of its own: the
//                     settings collection above is already readable by viewers
//                     and writable only by the owner and the accountant.
//  v11  2026-09-15  + THE ABAYA SHOPS (Al Sheikha Style) — a SEPARATE business
//                     from the restaurants: abaya_sellers, abaya_seller_pins,
//                     abaya_sales_reports. Deliberately separate collections,
//                     never the existing employees/sales_reports: mixing them
//                     would push abaya money into the restaurants' daily
//                     report, monthly financials, three balances and daily
//                     target, and would put the saleswomen into restaurant
//                     attendance and payroll lists.
//                     Readable by the OWNER and the ACCOUNTANT only. NOT by
//                     the supervisors, NOT by the secretary, and NOT by the
//                     viewers (balances.html) — the abaya business is none of
//                     their work.
//  v10  2026-09-14    sales_reports: the three branch supervisors may now READ
//                     and UPDATE a daily report so they can correct their own
//                     mistyped figure and resend it. DELETE was deliberately
//                     NOT granted to them and is now a separate line from
//                     update — removing money that came in stays with the owner
//                     and the accountant.
//   v9  2026-09-13  + petty_cash_requests, warning_requests — branch managers
//                     submit blind from the managers screen; the accountant
//                     approves cash, the secretary issues warnings. deductions
//                     now let the SECRETARY create/delete one ONLY when it
//                     carries source:'warning', because a warning deducts from
//                     salary automatically by management's rule.
//   v8  2026-09-13  + isAccountant/isSecretary/isSupervisor — four levels of
//                     access to admin.html. isAdmin() now means the OWNER only.
//                     Salaries stay readable by all four roles by management's
//                     decision, but only owner+accountant may change one.
//   v7  2026-09-13  + isViewer()           (balances.html — READ-ONLY viewers,
//                                          excluded from isAdmin, limited to
//                                          settings/sales_reports/financial_payments)
//   v6  2026-09-13  + financial_months     (Close month / frozen snapshot)
//   v5  2026-09-13  + financial_payments   (Monthly Financial Report tab)
//   --  (unlabelled, still said v4)  + sales_reports  (Daily Sales Report)
//   v4  initial     + training_content, training_acknowledgments,
//                     role system (Admin/Accountant/Secretary) REMOVED
//
// -----------------------------------------------------------------------------
// How to deploy:
//   1) Firebase Console -> Firestore Database -> Rules tab
//   2) Click in the editor, press Ctrl+A then Delete (box must be EMPTY)
//   3) Paste this ENTIRE file
//   4) Click "Publish" (top right). It is greyed out when the text on screen
//      is identical to what is already live — that is why the revision line
//      above must change on every edit.
//
// Role system (Admin/Accountant/Secretary) has been REMOVED per request.
// Any user who can sign in with a valid email/password Firebase Auth
// account (i.e. any account you create in Firebase Console > Authentication
// > Users) gets full read/write access to every collection below — there is
// no more admin_users/{uid} lookup, no more field-level salary/otRate
// restriction. The only gatekeeping left is:
//   1) Firebase Authentication itself — only accounts you create can log in.
//   2) These rules require request.auth != null (and non-anonymous for the
//      admin dashboard) for every read/write, so unauthenticated internet
//      traffic still gets nothing.
// "Kiosk" = the index.html check-in/leave-request page, signed in
// ANONYMOUSLY. It keeps the same narrow, write-mostly access as before
// (create attendance/leave_requests, read employees/pins/geofences to
// populate its dropdowns and verify PINs, but no update/delete).
// =============================================================================

function isSignedIn() {
  return request.auth != null;
}

function isRealLogin() {
  return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

// -----------------------------------------------------------------------------
// STAFF ROLES — restricted logins for the admin dashboard.
// -----------------------------------------------------------------------------
// Management asked for four levels of access to admin.html. These lists are the
// ONLY place a role is decided, and they must stay identical to ROLE_BY_EMAIL in
// admin.html. Hiding a tab in the page protects nothing on its own — anyone can
// call the database directly — so every limit below is enforced here as well.
//
// An address NOT on any list is the OWNER and keeps full access. These are
// restriction lists, not permission lists: creating an account with a different
// address than the one written here would make that person a full owner.
//
// Management's explicit decision: salaries are VISIBLE to all four roles, but
// only the owner and the accountant may CHANGE a salary. Firestore cannot hide
// one field on read, so visibility is a real grant, not a UI trick — but the
// write restriction below is genuinely enforced.
//
//   ACCOUNTANT  Shafiq — payroll, attendance, annual leave, sales, finance.
//               Reviews payroll; does NOT create or delete employees.
//   SECRETARY   Marieanne — employee profiles, warning letters, new
//               applications and leave requests.
//   SUPERVISOR  Bilal Abdulsamad, Ashraf Al Suhaili, Vikas — employee profiles,
//               attendance, leave requests and new applications.
//   VIEWER      balances.html only, read-only, three collections.
// -----------------------------------------------------------------------------
function isAccountant() {
  return isRealLogin() && request.auth.token.email in [
    'shafiq@alsheikhagroup.qa'
  ];
}

function isSecretary() {
  // Both addresses map to the secretary on purpose, so whichever one is created
  // in Firebase works and she can never fall through to full owner access.
  return isRealLogin() && request.auth.token.email in [
    'secretary@alsheikhagroup.qa',
    'marieanne@alsheikhagroup.qa'
  ];
}

function isSupervisor() {
  return isRealLogin() && request.auth.token.email in [
    'bilal.abdulsamad@alsheikhagroup.qa',
    'ashraf.alsuhaili@alsheikhagroup.qa',
    'vikas@alsheikhagroup.qa'
  ];
}

// Any restricted dashboard role.
function isStaff() {
  return isAccountant() || isSecretary() || isSupervisor();
}

// May open an employee profile and edit it, but never the salary field.
function isProfileEditor() {
  return isSecretary() || isSupervisor();
}

// True when an update leaves the salary exactly as it was. Uses get() with a
// default so a document that has no salary field yet does not fail the rule.
function salaryUnchanged() {
  return request.resource.data.get('salary', 0) == resource.data.get('salary', 0);
}

// -----------------------------------------------------------------------------
// VIEWERS — balances.html only, READ ONLY, and only three collections.
// -----------------------------------------------------------------------------
// These two people open balances.html to see the bank / delivery / cash figures
// and NOTHING else. A page with no buttons is not protection on its own: any
// email/password account used to be a full admin here, so they could simply
// open admin.html and change payroll. That is why the restriction lives in
// these rules and not only in the page.
//
// Consequences of being on this list, enforced server-side:
//   • READ  only the collections their two panels are computed from.
//   • NO access at all to employees, salaries, attendance, deductions, QID
//     photos, warnings, leave requests, audit log or training records.
//   • ⚠️⚠️⚠️ WRITE: this used to say "NO write, update or delete anywhere, ever"
//     and that is NO LONGER TRUE as of v16. The owner asked for Mrs Fatima to
//     send an arrived shipment to a shop and to set its selling price, and with
//     no backend in this project that can only be her own browser writing. Her
//     writes are enumerated in the v16 note at the top of this file and are
//     confined to FIVE abaya collections with per-field limits. She still has no
//     write of any kind outside the abaya business, and none at all on
//     employees, payroll, attendance or settings.
//     If you are reading this while auditing: the one thing to check is that
//     abaya_products `update` for a viewer stays hasOnly(['qty','updatedAt']).
//     That single clause is what stops her changing the price of anything
//     already on a shelf.
//
// The email must match EXACTLY the account created in
// Firebase Console > Authentication > Users. Create the accounts with these
// exact addresses — if an account is created with a different address it is
// NOT on this list and would be treated as a full admin instead.
function isViewer() {
  return isRealLogin() && request.auth.token.email in [
    'houti.anes@alsheikhagroup.qa',
    'fatima.alrumaihi@alsheikhagroup.qa'
  ];
}

// The OWNER: a real email/password login that is on none of the restricted
// lists. Only this account has full access to everything.
function isAdmin() {
  return isRealLogin() && !isViewer() && !isStaff();
}

function isKiosk() {
  return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- employees --------------------------------------------------------
    // Salaries are readable by all four roles by management's decision.
    // Creating: the secretary and supervisors accept new applications, so they
    // may create — but only at salary 0, which the owner or accountant then
    // sets. Updating: they may edit the profile as long as the salary is
    // untouched. Deleting is the owner's alone, since it removes the record.
    match /employees/{empId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow create: if isAdmin()
                    || (isProfileEditor() && request.resource.data.get('salary', 0) == 0);
      allow update: if isAdmin() || isAccountant()
                    || (isProfileEditor() && salaryUnchanged());
      allow delete: if isAdmin();
    }

    // ---- employee_pins ------------------------------------------------------
    // The PIN is part of the profile, so whoever edits profiles sets it.
    match /employee_pins/{empId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow write: if isAdmin() || isProfileEditor();
    }

    // ---- deductions (dated deduction-day entries) ----------------------------
    // Read is granted to every role so the payroll table they can already see
    // shows the CORRECT net salary. Without it the deductions would silently
    // come back empty and the screen would display an inflated figure, which is
    // worse than showing nothing. Writing stays with the owner and accountant.
    // The secretary issues warning letters and, by management's rule, a warning
    // deducts from salary automatically. She therefore needs to write a
    // deduction — but ONLY one carrying source:'warning'. She cannot create a
    // free-form salary deduction, and cannot edit an existing one at all.
    // Delete is allowed on the same narrow condition because removing a warning
    // letter removes its linked deduction.
    match /deductions/{deductionId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAdmin() || isAccountant()
                    || (isSecretary() && request.resource.data.get('source', '') == 'warning');
      allow update: if isAdmin() || isAccountant();
      allow delete: if isAdmin() || isAccountant()
                    || (isSecretary() && resource.data.get('source', '') == 'warning');
    }

    // ---- attendance ---------------------------------------------------------
    // The accountant needs it for payroll, the supervisors for their daily work.
    // The secretary was not given attendance. Corrections are payroll-affecting,
    // so only the owner and accountant may edit or delete a log.
    match /attendance/{logId} {
      allow read: if isAdmin() || isAccountant() || isSupervisor() || isKiosk();
      allow create: if isAdmin() || isKiosk();
      allow update, delete: if isAdmin() || isAccountant();
    }

    // ---- leave_requests -------------------------------------------------------
    // The secretary and the supervisors handle these; the accountant does not.
    match /leave_requests/{reqId} {
      allow read: if isAdmin() || isProfileEditor();
      allow create: if isKiosk() || isAdmin() || isProfileEditor();
      allow update, delete: if isAdmin() || isProfileEditor();
    }

    // ---- employee_applications (self-registration by new hires from the
    // index.html kiosk page) ---------------------------------------------------
    // Kiosk (any visitor) can submit a new application, but can never read
    // the list back (so one applicant can't browse everyone else's QID
    // photos/phone numbers) and can never update/delete once submitted.
    // Only the admin dashboard can review, approve, or reject.
    // The secretary and supervisors review and approve them; the accountant
    // has no access to applicants' QID photos and phone numbers.
    match /employee_applications/{appId} {
      allow read: if isAdmin() || isProfileEditor();
      allow create: if isKiosk() || isAdmin() || isProfileEditor();
      allow update, delete: if isAdmin() || isProfileEditor();
    }

    // ---- branch_geofences ---------------------------------------------------
    // Read so the branch dropdowns fill in; only the owner moves a geofence.
    match /branch_geofences/{branchId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- settings ------------------------------------------------------------
    // Holds financial_rates, cash_account (opening balances), salary_payouts and
    // cash_movements, plus the legacy single geofence doc if still present.
    // Viewers may READ (balances.html needs these four docs) but never write.
    match /settings/{docId} {
      allow read: if isAdmin() || isStaff() || isKiosk() || isViewer();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- employee_warnings (Warning Letters tab) ----------------------------
    // The secretary's job. The accountant and supervisors have no access.
    match /employee_warnings/{warnId} {
      allow read, write: if isAdmin() || isSecretary();
    }

    // ---- annual_leaves ------------------------------------------------------
    // Granted to the accountant because a leave writes a 21-day deduction plus
    // two 750 allowances straight into the payroll he has to reconcile.
    // Readable by the others so the payroll figures they see stay correct.
    match /annual_leaves/{leaveId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- allowance_payments (linked leave/ticket allowance payouts created
    // automatically when an Annual Leave is saved — tied to annual_leaves, so
    // the same access applies) ----------------------------------------------
    match /allowance_payments/{paymentId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- admin_users (legacy collection from the old role system — no
    // longer used by the app, kept locked down in case old docs linger) -----
    match /admin_users/{uid} {
      allow read, write: if isAdmin();
    }

    // ---- audit_log (read-only trail of key mutating actions — admin-only
    // read/create, NO update/delete allowed for anyone, keeping the log
    // immutable/tamper-resistant once written) -------------------------------
    // Every role may CREATE an entry, otherwise their actions would go
    // unrecorded and the trail would only cover the owner — defeating its
    // purpose now that five people can change data. Only the owner READS it.
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isStaff();
      allow update, delete: if false;
    }

    // ---- training_content (the daily work guide/protocol text+images per
    // restaurant+department, doc id = {RESTAURANT}__{DEPARTMENT}) -----------
    // The kiosk (Employee Training tab) only ever needs to READ this to show
    // it to the employee; only the admin dashboard's Training Content editor
    // ever writes it.
    match /training_content/{docId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- training_acknowledgments (permanent proof an employee confirmed
    // reading the training guide) --------------------------------------------
    // The kiosk creates one on each confirmation (and re-reads its own
    // history to show the "already confirmed" banner isn't strictly needed
    // server-side, but allowing isKiosk() read here keeps that banner
    // working without a separate admin-only round trip). Only the admin
    // dashboard's Training Records view otherwise reads these. NO update/
    // delete for anyone — this must stay a permanent, tamper-resistant audit
    // trail, exactly like audit_log above.
    match /training_acknowledgments/{ackId} {
      allow read: if isAdmin() || isKiosk();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if false;
    }

    // ---- petty_cash_requests (a branch manager asks for cash from the
    // managers-only screen in index.html) -------------------------------------
    // Same blind-submit pattern as sales_reports: the kiosk may CREATE but can
    // never read one back, so a manager cannot browse other branches' requests
    // or see the amounts they asked for. The accountant reviews and approves,
    // which is what turns it into a variable expense.
    match /petty_cash_requests/{reqId} {
      allow read: if isAdmin() || isAccountant();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if isAdmin() || isAccountant();
    }

    // ---- warning_requests (a branch manager asks the secretary to issue a
    // warning letter for an employee) ----------------------------------------
    // Blind submit as above. Only the secretary and the owner see them; the
    // accountant has no reason to read staff discipline cases.
    match /warning_requests/{reqId} {
      allow read: if isAdmin() || isSecretary();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if isAdmin() || isSecretary();
    }

    // ---- financial_months (one doc per closed month, id = 'YYYY-MM') --------
    // Holds the frozen snapshot of a month's financial figures once management
    // closes it, so a past month can never be silently recalculated by a later
    // salary edit or employee deletion. Admin-only in both directions: the
    // kiosk has no reason to read or write an accounting record.
    // The accountant closes the month, so he needs both read and write here.
    match /financial_months/{monthId} {
      allow read, write: if isAdmin() || isAccountant();
    }

    // ---- financial_payments (the fixed/variable payment lines that feed the
    // Monthly Financial Report tab in the admin dashboard) -------------------
    // Admin-only in BOTH directions. Unlike sales_reports the kiosk has no
    // reason to even create these: rent, salaries and purchase figures are
    // entered by management on the dashboard, never from the employee page.
    // Viewers may READ these (money going out is part of the balance) but can
    // never add, change or delete a payment.
    match /financial_payments/{paymentId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- sales_reports (the Daily Sales Report a branch manager submits from
    // the managers-only #report screen in index.html) ------------------------
    // The kiosk page may CREATE a report but can NEVER read one back. Sales
    // figures are commercially sensitive and index.html is signed in
    // ANONYMOUSLY, so granting it read access here would expose every branch's
    // revenue to anyone who can open that page. Managers therefore submit
    // "blind" and only get a confirmation message; the figures are readable
    // exclusively from the admin dashboard's Daily Report tab.
    // Update is admin-only as well: a manager who mistyped simply submits
    // again, and the admin deletes the wrong entry — this also means a
    // malicious anonymous caller cannot overwrite a real report it cannot read.
    // Viewers may READ these (money coming in is part of the balance) but can
    // never submit, change or delete a report.
    // v10: the three branch supervisors (Bilal, Ashraf, Vikas) may now READ and
    // CORRECT a daily report, by management's decision — they are the ones who
    // submitted it and who notice a wrong figure first. They may NOT delete one:
    // a mistyped report is fixed by correcting it, and deleting the money that
    // came in is a different act reserved for the owner and the accountant.
    match /sales_reports/{reportId} {
      allow read: if isAdmin() || isAccountant() || isViewer() || isSupervisor();
      allow update: if isAdmin() || isAccountant() || isSupervisor();
      allow delete: if isAdmin() || isAccountant();
      allow create: if isKiosk() || isAdmin();
    }

    // =========================================================================
    // THE ABAYA SHOPS — Al Sheikha Style
    // -------------------------------------------------------------------------
    // A SEPARATE business from the restaurants. Three shops: Gulf Mall,
    // Vendome Mall, Doha Festival City.
    //
    // ⚠️ Why separate collections and not the existing employees/sales_reports?
    // Because sharing them would silently corrupt the restaurants:
    //   • abaya money would enter the restaurants' Daily Report, the Monthly
    //     Financial report, the three balances and the Daily Target;
    //   • the saleswomen would appear in restaurant attendance and payroll.
    // The owner asked for the two businesses never to touch. These rules are
    // where that guarantee actually lives — hiding a tab does not enforce it.
    //
    // Access: the OWNER and the ACCOUNTANT only. NOT the supervisors (Bilal,
    // Ashraf, Vikas), NOT the secretary, and NOT the viewers of balances.html.
    // =========================================================================

    // ---- abaya_sellers (the saleswomen: name only, no salary, no documents) --
    // The seller panel (abaya-seller.html) is signed in ANONYMOUSLY and needs
    // to READ this list to fill its dropdown. Nothing sensitive lives here —
    // only a display name — which is exactly why the list is a separate
    // collection instead of a flag on an employee record.
    // Only the owner may add or remove a seller.
    match /abaya_sellers/{sellerId} {
      allow read: if isAdmin() || isAccountant() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- abaya_seller_pins --------------------------------------------------
    // Same shape and the same trade-off as employee_pins: the panel has no
    // backend, so it must read the PIN to compare it in the browser. The PIN
    // is therefore a convenience gate, not a secret — the real protections are
    // these rules plus Firebase App Check. Kept in its own collection so a
    // future backend can lock reads away without touching the seller list.
    match /abaya_seller_pins/{sellerId} {
      allow read: if isAdmin() || isAccountant() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- abaya_sales_reports (the daily report a saleswoman submits) ---------
    // Submit-blind, exactly like sales_reports: the panel may CREATE a report
    // but can NEVER read one back. It is signed in anonymously, so read access
    // would expose every shop's revenue to anyone who opens that page. She gets
    // a confirmation summary built from what she just typed, not from a query.
    //
    // The report also carries what is OWED TO SHANTON (the designer whose
    // abayas are sold on consignment for a fixed 200 QAR commission per piece).
    // That is a liability figure, one more reason it is not world-readable.
    //
    // Correcting and deleting stay with the owner and the accountant — the same
    // split as the restaurants' reports, minus the supervisors who have no part
    // in this business.
    // v12: the VIEWERS may now READ these as well, for abaya-balances.html —
    // the read-only page the owner and Mrs Fatima open to see the abaya
    // account, target and stock. This is a deliberate change to v11, which
    // limited the abaya business to the owner and the accountant.
    // READ only: they still cannot submit, correct or delete a report, cannot
    // add a saleswoman, and cannot touch the rates, the targets or the stock
    // count — those stay writes, and no viewer has any write anywhere.
    match /abaya_sales_reports/{reportId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow update: if isAdmin() || isAccountant();
      allow delete: if isAdmin() || isAccountant();
      allow create: if isKiosk() || isAdmin();
    }

    // NOTE: the abaya settings documents (settings/abaya_rates for the card fee
    // and Shanton's per-piece commission, settings/abaya_stock_opening for the
    // opening stock count of each shop) need NO rule of their own — they live
    // inside the settings collection already covered above, which the panel may
    // read and the owner and accountant may write.

    // ---- manager_cards (the manager's photo, name and job title) -------------
    // Exists ONLY so Mrs Fatima can see a face and a title next to each manager.
    // She is a VIEWER and cannot read the employees collection at all — that one
    // carries salaries, QID numbers and QID photographs. So the card is a
    // deliberate, minimal copy: name, branch, job title, small photo. Nothing
    // here is confidential, which is exactly why it can be a separate readable
    // collection instead of opening up employee records.
    //
    // ⚠️ The photo must NEVER be taken from qidFront / qidBack. Those are
    // identity documents; putting one here would publish a manager's QID to
    // everyone who can read this collection. The owner uploads a normal
    // photograph from the dashboard.
    //
    // Only the OWNER writes: a manager cannot change his own photo or title, and
    // the restricted dashboard roles have no reason to.
    match /manager_cards/{empId} {
      allow read: if isAdmin() || isStaff() || isViewer();
      allow write: if isAdmin();
    }

    // ---- manager_presence (on duty / finished / off) -------------------------
    // One document per EVENT, never one per manager: 'start' (with the hour he
    // says he will finish), 'end' (he confirms he has finished) and 'off' (a day
    // he is not working, declared in advance). The current state of a manager on
    // a given day is simply his LATEST event of that day.
    //
    // Why append-only instead of one editable document per manager per day:
    // the managers' screen signs in anonymously (isKiosk) exactly like the staff
    // kiosk, so granting it update would let anyone who opens that link rewrite
    // an existing record. Creating a new event is the weakest permission that
    // still does the job, and it leaves a history that cannot be altered.
    //
    // ⚠️ This is NOT attendance and must never be treated as such: it does not
    // feed payroll, it carries no worked-hours figure, and management asked for
    // no location check on it. It is a courtesy status for Mrs Fatima.
    //
    // The honest limit, stated rather than hidden: the managers' screen proves
    // who is pressing only by a PIN checked inside the browser, so these rules
    // cannot verify that the manager named in the document is the person who
    // pressed. That is the same level of trust as the daily sales report and the
    // petty-cash request, which already work this way. Because nothing here
    // affects money, the consequence of a false entry is a wrong dot on a
    // screen, not a wrong payment.
    match /manager_presence/{eventId} {
      allow read: if isAdmin() || isStaff() || isViewer();
      allow create: if isKiosk() || isAdmin();
      // History is not rewritable — a mistake is corrected by a NEW event.
      allow update: if false;
      // The owner alone may remove a test entry.
      allow delete: if isAdmin();
    }

    // ---- supervisor_presence (the Supervisors board) --------------------------
    // A small MIRROR of a supervisor's real punch on the staff attendance page,
    // written at the same moment as the attendance record itself: name, branch,
    // Check-In or Check-Out, and the time. Nothing else — and deliberately NO
    // location, even though the attendance record it mirrors has one.
    //
    // Why this collection exists at all, rather than letting the viewers read
    // `attendance` directly: that collection holds every employee's complete
    // history and the GPS coordinates of every single punch, and Firestore cannot
    // hide some rows or some fields on a read. It is all or nothing. The owner
    // was asked and chose not to open it. So `attendance` above stays closed to
    // viewers, and this carries only what the board needs.
    //
    // Append-only for the kiosk, for the same reason as manager_presence: the
    // staff page signs in anonymously, so granting update would let anyone who
    // opens that link rewrite an existing record. Creating a new event is the
    // weakest permission that still does the job. The current state of a
    // supervisor on a given day is simply his latest event of that day.
    //
    // ⚠️ This is NOT the attendance record and must never be treated as one. It
    // does not feed payroll, it carries no worked-hours figure, and a missing
    // mirror event does not mean the person did not clock in — it means the
    // mirror write did not land. The board says "no record" for that, never
    // "absent", because the truth about attendance lives in `attendance`.
    match /supervisor_presence/{eventId} {
      allow read: if isAdmin() || isStaff() || isViewer();
      allow create: if isKiosk() || isAdmin();
      // History is not rewritable — a correction is a NEW event.
      allow update: if false;
      // The owner alone may remove a test entry.
      allow delete: if isAdmin();
    }

    // ---- abaya_seller_cards (the saleswomen's photo and title) ---------------
    // The same idea as manager_cards, but a SEPARATE collection on purpose.
    //
    // Why not simply add the saleswomen to manager_cards: the owner's instruction
    // was absolute — "the saleswomen have nothing to do with the restaurants, I
    // do not want even a smell of them in the restaurants, and the other way
    // round". Putting their documents inside the restaurants' own collection is
    // exactly that mixing, and it would then depend on every reader remembering
    // to filter. One forgotten filter puts a saleswoman on the managers' board.
    // Two collections cannot mix by accident; a shared one can only be kept
    // apart by discipline. This costs one rules deployment and buys certainty.
    //
    // Document id = the EMPLOYEE FILE id, not the abaya_sellers id, because the
    // presence events below are keyed by the employee file (attendance and
    // payroll both work on employee files).
    //
    // ⚠️ NEVER a Qatar ID photograph here, exactly as with manager_cards: that is
    // an official document, and this collection is readable by the viewers. The
    // owner uploads an ordinary photograph from the dashboard.
    match /abaya_seller_cards/{empId} {
      allow read: if isAdmin() || isStaff() || isViewer();
      allow write: if isAdmin();
    }

    // ---- abaya_presence (who is in a shop right now) -------------------------
    // A small MIRROR of a saleswoman's real punch on her own screen, written at
    // the same moment as the attendance record: her name, the shop she picked,
    // Check-In or Check-Out, and the time. No location — her punch deliberately
    // has none, by the owner's decision.
    //
    // Separate from supervisor_presence for the same reason as the cards above:
    // the restaurants' board reads supervisor_presence by date, so a saleswoman
    // landing there would appear on it.
    //
    // Why not let the viewers read `attendance` directly: that collection holds
    // every employee's complete history and the GPS coordinates of every punch,
    // and Firestore cannot hide some rows or some fields on a read — it is all or
    // nothing. So `attendance` stays closed to viewers and this carries only what
    // the board needs.
    //
    // Append-only for the kiosk, like the two boards above: the saleswoman's page
    // signs in anonymously, so granting update would let anyone who opens that
    // link rewrite an existing record. Her current state is simply her LATEST
    // event of that day — a Check-Out is a NEW document, never an edit.
    //
    // ⚠️ This is NOT the attendance record and must never be treated as one. It
    // does not feed payroll and carries no worked-hours figure. A missing mirror
    // event does not mean she did not clock in — it means the mirror write did
    // not land. The truth about attendance lives in `attendance`.
    match /abaya_presence/{eventId} {
      allow read: if isAdmin() || isStaff() || isViewer();
      allow create: if isKiosk() || isAdmin();
      // History is not rewritable — a correction is a NEW event.
      allow update: if false;
      // The owner alone may remove a test entry.
      allow delete: if isAdmin();
    }

    // ======================================================================
    // ---- THE ABAYA CATALOGUE — three collections ---------------------------
    // ======================================================================
    // The owner's own words: "most of the pictures are THE SAME in every shop,
    // only the quantity differs". So the catalogue is built around ONE document
    // per DESIGN — its picture, its barcode, its cost and its two prices are
    // stored ONCE — and the per-shop quantities live inside that same document
    // as a map: qty: { GULF_MALL: 4, VENDOME_MALL: 2, ... }.
    //
    // ⚠️ WHY THAT MATTERS AND IS NOT A DETAIL: the alternative (one document per
    // design PER SHOP) would store the SAME photograph four times. At roughly
    // 100 designs that is 400 pictures instead of 100 — four times the storage,
    // four times Mrs Fatima's mobile data, and worst of all FOUR PLACES to
    // correct when one price changes, which is how two shops end up quoting two
    // different prices for the same abaya.
    //
    // ⚠️ THE DOCUMENT ID IS THE BARCODE (sanitised). That is deliberate: when a
    // saleswoman scans or types a barcode the page reads ONE document directly
    // by id — no query, no composite index, no collection scan. It is also what
    // makes a duplicate barcode IMPOSSIBLE rather than merely discouraged.
    //
    // ⚠️ THIS IS NOT THE OLD STOCK COUNT AND MUST NEVER BE MIXED WITH IT. The
    // existing figures (abaya_sales_reports + settings/abaya_stock_opening) count
    // stock BY TYPE — Shanton, Dress, Inner… — and feed the money. This counts
    // individual PIECES and feeds nothing financial. Both are true at once
    // because they answer different questions. By the owner's explicit
    // instruction the old count is left exactly as it was.

    // ---- abaya_products (one document per DESIGN, id = the barcode) ---------
    // Fields: code, name, cost, price, discountPrice, qty{shopKey:n}, active,
    // hasImage, createdAt, updatedAt. NO picture here — see the next collection.
    //
    // Reading: the owner and the accountant run the business; the VIEWERS are
    // the owner's second account and Mrs Fatima, whose read-only panel shows the
    // catalogue; and the KIOSK is the saleswoman's own page, which must be able
    // to look a barcode up in order to sell it.
    //
    // ⚠️ Writing is split in two on purpose. The saleswoman's page signs in
    // ANONYMOUSLY, so "the kiosk" is in practice anyone who opens that link.
    // Granting it a plain update would let a stranger rewrite the SELLING PRICE
    // of every abaya. So the kiosk may change NOTHING BUT the quantity map:
    // affectedKeys().hasOnly(['qty','updatedAt']). Prices, cost, barcode and
    // name are the owner's alone, and a rule — not a screen — is what enforces
    // that, because a screen can be bypassed from the browser's own tools.
    // ⚠️⚠️⚠️ v16 — THE VIEWER (Mrs Fatima) MAY NOW CREATE, AND MAY ADD QUANTITY.
    // She dispatches an arrived shipment to a shop from her own panel, and with
    // no backend that write is hers. Two different grants, deliberately unequal:
    //
    //   CREATE — allowed in full, because a shipment with a barcode nobody has
    //   sold before IS a new design and her selling price is the whole point of
    //   the step the owner described ("هي التي تضع سعر البيع").
    //
    //   UPDATE — restricted to hasOnly(['qty','updatedAt']), the SAME clause the
    //   kiosk lives under. So sending a second shipment of a design that is
    //   already on a shelf ADDS PIECES and cannot touch the price, the barcode,
    //   the name or the discount. ⚠️ DO NOT widen this to include 'price' for
    //   her convenience: that is the difference between "she prices new goods"
    //   and "she can reprice the whole shop". Repricing existing stock stays the
    //   owner's, and her panel already has the WhatsApp request for asking.
    //
    //   DELETE stays the owner's alone.
    match /abaya_products/{productId} {
      allow read: if isAdmin() || isAccountant() || isViewer() || isKiosk();
      allow create: if isAdmin() || isViewer();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        // ⚠️ الكشكُ يبقى على ['qty','updatedAt'] وحدَهما: شاشةُ البياعة مجهولةُ
        //   الدخول، فكلُّ ما تستطيع تغييرَه يستطيعه كلُّ من يملك الرابط — ومقاسٌ
        //   يُكتب من هناك يُفسد وصفَ البضاعة على كلّ شاشة.
        || (isKiosk()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'updatedAt']))
        // ⚠️ والسيدةُ فاطمة تزيد 'size' عليهما (v17): شحنةٌ ثانيةٌ من نفس الباركود
        //   تصل بمقاساتٍ مختلفةٍ عادةً، وبلا ذلك يبقى سطرُ المقاسات قديمًا بلا
        //   سبيلٍ لتصحيحه. والمقاسُ لا يحمل مالًا ولا يُشبه سعرًا.
        //   ⚠️⚠️ ولا يزيد عليها 'price' بحال — هذا هو الحدُّ الذي يفصل «تُسعّر
        //   الجديدَ» عن «تُعيد تسعيرَ المحلّ كلِّه».
        || (isViewer()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'size', 'updatedAt']));
    }

    // ---- abaya_product_costs (WHAT THE ABAYA COST US) -----------------------
    // id = the same id as the product, holding one number: cost.
    //
    // ⚠️⚠️⚠️ WHY THIS IS NOT A FIELD ON THE PRODUCT, and it is not a detail:
    // abaya_products must be readable by the KIOSK, because the saleswoman's page
    // has to look a barcode up in order to sell it — and that page signs in
    // ANONYMOUSLY, so "the kiosk" is in practice ANYONE who opens the link.
    // Firestore cannot return "some fields" of a document: a read brings the
    // whole thing. So a cost field sitting on the product would be readable by
    // anyone with the link — our purchase price, the one number a competitor
    // would most like to have. Kept in its own document, the kiosk simply has
    // no rule for it and the read is refused.
    //
    // The accountant may read it because it is a purchase figure and it belongs
    // in his stock valuation.
    //
    // ⚠️⚠️ THE VIEWERS WERE ADDED BY THE OWNER'S EXPLICIT INSTRUCTION: "هاي
    // السيدة فاطمة يجب ان يظهر سعر الكوست". This rule previously refused them,
    // with a comment saying her screen shows what we sell for and never what we
    // paid — that was MY judgement, and the owner has overruled it. It is a
    // reasonable call: her panel already shows the shops' sales, the real income,
    // the commission and what is owed to Shanton, so the purchase price is not a
    // wider circle of trust than she already stands in.
    //
    // ⚠️⚠️⚠️ AND THE KIOSK IS STILL REFUSED, DELIBERATELY. That is not the same
    // decision. The viewers are two named email/password accounts the owner
    // created himself. The kiosk is an ANONYMOUS sign-in, which in practice means
    // anybody who has the saleswoman's link — so cost there would be our purchase
    // price published to the world. Never add isKiosk() to this rule.
    // ⚠️ v16: the viewer may now WRITE this. When she sends an arrived shipment
    // to a shop, the cost the owner recorded on that shipment has to land on the
    // catalogue line, or the catalogue would show a piece with no cost and his
    // "stock at cost" figure would understate by that whole shipment. She is not
    // typing a cost — her screen copies the one HE entered on the arrival.
    // ⚠️⚠️ Note the consequence, which is deliberate and reported to him: if a
    // design is restocked at a different purchase price, this document ends up
    // holding the LATEST shipment's cost. Nothing is lost — every shipment keeps
    // its own cost forever in abaya_arrivals — but the catalogue's single cost
    // field can only hold one number, and the newest is the useful one.
    match /abaya_product_costs/{productId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow write: if isAdmin() || isViewer();
    }

    // ---- abaya_product_images (the photograph, one document per design) -----
    // id = the SAME id as the product, holding nothing but the compressed JPEG
    // as a base64 data URL.
    //
    // ⚠️ WHY THE PICTURE IS NOT A FIELD ON THE PRODUCT: Firestore cannot return
    // "some fields" of a document — a read brings the whole thing. With the
    // picture inside, listing 100 designs would download about 15 MB onto Mrs
    // Fatima's telephone every time she opened the screen, to show a list of
    // names. Split like this, the list costs a few kilobytes and a picture is
    // fetched ONLY for the abaya actually being looked at.
    //
    // Only the owner uploads: a saleswoman changing a photograph would change
    // what the shop is shown to be selling.
    // ⚠️ v16: the viewer may now write, so the photograph taken when the shipment
    // arrived becomes the catalogue photograph without anyone finding and
    // uploading it a second time. Her screen only writes it when the product has
    // NO picture yet — replacing the picture of something already on a shelf
    // changes what the shop is shown to be selling, and that stays the owner's.
    // That restraint is in her page, not in this rule, because a rule cannot read
    // the old document's hasImage flag on a create.
    match /abaya_product_images/{productId} {
      allow read: if isAdmin() || isAccountant() || isViewer() || isKiosk();
      allow write: if isAdmin() || isViewer();
    }

    // ---- abaya_product_moves (who moved which piece, and when) -------------
    // One document per movement: the design, the shop, how many, why, and which
    // saleswoman did it. This is the ANSWER to "the quantity went down — who?".
    //
    // ⚠️ Append-only, exactly like abaya_presence: the page signs in
    // anonymously, so update must stay closed or an old line could be rewritten
    // to hide a piece. A correction is a NEW line in the opposite direction.
    //
    // ⚠️ This is NOT a sales record and carries no money. It does not feed the
    // daily report, the commission or the target. A missing line here means the
    // movement write did not land — never that nothing was sold.
    // ⚠️ v16: the viewer may now CREATE a line — the pieces she sends to a shop
    // must appear in "what moved, and who moved it" under her own name. Without
    // it the quantity of a shop would rise with no line explaining why, which is
    // the exact question this log exists to answer.
    // Update stays closed to everyone, as before: a correction is a NEW line.
    match /abaya_product_moves/{moveId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow create: if isKiosk() || isAdmin() || isViewer();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ======================================================================
    // ---- NEW GOODS ARRIVED — abaya_arrivals + abaya_arrival_images ---------
    // ======================================================================
    // One document per SHIPMENT, not per design. The owner records a shipment the
    // moment it lands: its barcode, what it is, who supplied it, the price of one
    // piece in dollars, the rate used, the price in riyals, how many pieces, the
    // shipping, the labour — and the two figures the system works out from those,
    // the total paid and the cost of ONE piece.
    //
    // ⚠️ THE DOCUMENT ID IS AUTOMATIC, NOT THE BARCODE, and that is not a detail:
    // the same barcode can arrive three times at three different prices. Keyed by
    // barcode, the second shipment would overwrite the first and the cost of a
    // shipment that was really paid for would be gone. Each arrival stands alone,
    // and `productId` links it to the catalogue line it will become.
    //
    // ⚠️⚠️⚠️ THE KIOSK IS REFUSED, AND MUST STAY REFUSED. This document holds OUR
    // PURCHASE PRICE, our shipping cost and OUR SUPPLIER'S NAME. The saleswoman's
    // page signs in ANONYMOUSLY, so "the kiosk" is in practice anybody who opens
    // that link. This is the same reasoning that keeps abaya_product_costs out of
    // the product document, only worse — a cost is one number, a supplier is a
    // relationship a competitor can go and buy from. NEVER add isKiosk() here.
    //
    // ⚠️ THE VIEWER'S UPDATE IS THE NARROWEST CLAUSE IN THIS FILE, on purpose:
    //   • hasOnly([...]) — she writes the six dispatch fields and nothing else.
    //     Every purchase figure is outside that list, so she cannot alter what we
    //     paid, and cannot rewrite history to make a margin look better.
    //   • status != 'sent' — she cannot dispatch the same shipment twice. Without
    //     this a second press would add the pieces to a shop AGAIN and inflate
    //     the shelf by a whole shipment, with the log showing two arrivals for
    //     goods that came once.
    //   • no create, no delete — recording and removing a shipment is the
    //     owner's; her step is only "where does it go and what does it sell for".
    match /abaya_arrivals/{arrivalId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isViewer()
            && resource.data.get('status', 'waiting') != 'sent'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'sentShop', 'sentPieces', 'sellingPrice',
                           'sentAt', 'sentBy', 'updatedAt']));
    }

    // ---- abaya_arrival_images (the photograph of an arriving shipment) ------
    // id = the arrival id. Split off the arrival document for the same reason the
    // catalogue splits its pictures: Mrs Fatima's panel lists the waiting
    // shipments every time she opens it, and a picture inside each row would make
    // that list megabytes on a telephone in order to show a few names. The
    // picture of a row is fetched only when that row reaches her screen.
    //
    // She may write it because dispatching copies this picture onto the new
    // catalogue line. The kiosk is refused: it has no business seeing goods that
    // have not been put on a shelf yet, and this collection is keyed to documents
    // it must never read.
    match /abaya_arrival_images/{arrivalId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow write: if isAdmin() || isViewer();
    }

    // NOTE: the discount-season switch (settings/abaya_discount) needs NO rule of
    // its own — it lives inside the settings collection already covered above.

    // ---- employee_offers (the job-offer PDF for a sponsorship transfer) ------
    // One document per employee, id = the employee id, holding the offer PDF as
    // a base64 data URL plus the file name and who uploaded it.
    //
    // ⚠️ WHY A SEPARATE COLLECTION and not a field on the employee record: the
    // employee document already carries FIVE base64 images (QID front and back,
    // health card, contract, health certificate) and Firestore's hard ceiling is
    // 1 MB per document. Adding a PDF on top could push a record over that
    // limit, which would make not only this save fail but EVERY later edit to
    // that employee fail — i.e. it would disable a whole employee file. Keeping
    // the PDF in its own document makes that impossible.
    //
    // Same access as the employee profile it belongs to: whoever may edit
    // profiles may attach or remove the offer, and the kiosk never sees it.
    match /employee_offers/{empId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isProfileEditor();
    }

    // ---- Default deny for anything not explicitly listed above ---------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
