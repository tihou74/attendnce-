rules_version = '2';

// =============================================================================
// Al Sheikha Group — Attendance & Payroll — Firestore Security Rules
//
//   >>>  RULES REVISION: v11   (2026-09-15)  <<<
//
// -----------------------------------------------------------------------------
// HOW TO TELL WHICH REVISION IS ACTUALLY LIVE ON THE SERVER
// -----------------------------------------------------------------------------
// Do NOT judge by this header alone. Instead, in the Firebase Console
// (Firestore Database -> Rules), click inside the editor, press Ctrl+F and
// search for:
//
//       abaya_sales_reports
//
//   FOUND     -> v11 is live. Good.
//   NOT FOUND -> an OLDER revision is live. Select all (Ctrl+A), Delete,
//                paste this ENTIRE file, then click "Publish".
//                (Searching for an older marker such as financial_payments is
//                 not enough — always search for the newest collection added.)
//
// A missing collection shows up in the dashboard as:
//       "Error: Missing or insufficient permissions."
//
// -----------------------------------------------------------------------------
// REVISION HISTORY  —  ALWAYS bump the revision line above on EVERY change.
// -----------------------------------------------------------------------------
// If the revision line is not bumped, the header of an old published version
// looks IDENTICAL to the new file, so nobody can tell them apart in the
// console and the new rules are assumed to be live when they are not. That
// exact mistake happened with the "(v4)" label, which never changed across
// three different rule sets and caused a real "insufficient permissions"
// failure to go undiagnosed. Bump it every single time.
//
//  v11  2026-09-15  + THE ABAYA SHOPS (Al Sheikha Style) — a SEPARATE business
//                     from the restaurants: abaya_sellers, abaya_seller_pins,
//                     abaya_sales_reports. Deliberately separate collections,
//                     never the existing employees/sales_reports: mixing them
//                     would push abaya money into the restaurants' daily
//                     report, monthly financials, three balances and daily
//                     target, and would put the saleswomen into restaurant
//                     attendance and payroll lists.
//                     Readable by the OWNER and the ACCOUNTANT only. NOT by
//                     the supervisors, NOT by the secretary, and NOT by the
//                     viewers (balances.html) — the abaya business is none of
//                     their work.
//  v10  2026-09-14    sales_reports: the three branch supervisors may now READ
//                     and UPDATE a daily report so they can correct their own
//                     mistyped figure and resend it. DELETE was deliberately
//                     NOT granted to them and is now a separate line from
//                     update — removing money that came in stays with the owner
//                     and the accountant.
//   v9  2026-09-13  + petty_cash_requests, warning_requests — branch managers
//                     submit blind from the managers screen; the accountant
//                     approves cash, the secretary issues warnings. deductions
//                     now let the SECRETARY create/delete one ONLY when it
//                     carries source:'warning', because a warning deducts from
//                     salary automatically by management's rule.
//   v8  2026-09-13  + isAccountant/isSecretary/isSupervisor — four levels of
//                     access to admin.html. isAdmin() now means the OWNER only.
//                     Salaries stay readable by all four roles by management's
//                     decision, but only owner+accountant may change one.
//   v7  2026-09-13  + isViewer()           (balances.html — READ-ONLY viewers,
//                                          excluded from isAdmin, limited to
//                                          settings/sales_reports/financial_payments)
//   v6  2026-09-13  + financial_months     (Close month / frozen snapshot)
//   v5  2026-09-13  + financial_payments   (Monthly Financial Report tab)
//   --  (unlabelled, still said v4)  + sales_reports  (Daily Sales Report)
//   v4  initial     + training_content, training_acknowledgments,
//                     role system (Admin/Accountant/Secretary) REMOVED
//
// -----------------------------------------------------------------------------
// How to deploy:
//   1) Firebase Console -> Firestore Database -> Rules tab
//   2) Click in the editor, press Ctrl+A then Delete (box must be EMPTY)
//   3) Paste this ENTIRE file
//   4) Click "Publish" (top right). It is greyed out when the text on screen
//      is identical to what is already live — that is why the revision line
//      above must change on every edit.
//
// Role system (Admin/Accountant/Secretary) has been REMOVED per request.
// Any user who can sign in with a valid email/password Firebase Auth
// account (i.e. any account you create in Firebase Console > Authentication
// > Users) gets full read/write access to every collection below — there is
// no more admin_users/{uid} lookup, no more field-level salary/otRate
// restriction. The only gatekeeping left is:
//   1) Firebase Authentication itself — only accounts you create can log in.
//   2) These rules require request.auth != null (and non-anonymous for the
//      admin dashboard) for every read/write, so unauthenticated internet
//      traffic still gets nothing.
// "Kiosk" = the index.html check-in/leave-request page, signed in
// ANONYMOUSLY. It keeps the same narrow, write-mostly access as before
// (create attendance/leave_requests, read employees/pins/geofences to
// populate its dropdowns and verify PINs, but no update/delete).
// =============================================================================

function isSignedIn() {
  return request.auth != null;
}

function isRealLogin() {
  return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

// -----------------------------------------------------------------------------
// STAFF ROLES — restricted logins for the admin dashboard.
// -----------------------------------------------------------------------------
// Management asked for four levels of access to admin.html. These lists are the
// ONLY place a role is decided, and they must stay identical to ROLE_BY_EMAIL in
// admin.html. Hiding a tab in the page protects nothing on its own — anyone can
// call the database directly — so every limit below is enforced here as well.
//
// An address NOT on any list is the OWNER and keeps full access. These are
// restriction lists, not permission lists: creating an account with a different
// address than the one written here would make that person a full owner.
//
// Management's explicit decision: salaries are VISIBLE to all four roles, but
// only the owner and the accountant may CHANGE a salary. Firestore cannot hide
// one field on read, so visibility is a real grant, not a UI trick — but the
// write restriction below is genuinely enforced.
//
//   ACCOUNTANT  Shafiq — payroll, attendance, annual leave, sales, finance.
//               Reviews payroll; does NOT create or delete employees.
//   SECRETARY   Marieanne — employee profiles, warning letters, new
//               applications and leave requests.
//   SUPERVISOR  Bilal Abdulsamad, Ashraf Al Suhaili, Vikas — employee profiles,
//               attendance, leave requests and new applications.
//   VIEWER      balances.html only, read-only, three collections.
// -----------------------------------------------------------------------------
function isAccountant() {
  return isRealLogin() && request.auth.token.email in [
    'shafiq@alsheikhagroup.qa'
  ];
}

function isSecretary() {
  // Both addresses map to the secretary on purpose, so whichever one is created
  // in Firebase works and she can never fall through to full owner access.
  return isRealLogin() && request.auth.token.email in [
    'secretary@alsheikhagroup.qa',
    'marieanne@alsheikhagroup.qa'
  ];
}

function isSupervisor() {
  return isRealLogin() && request.auth.token.email in [
    'bilal.abdulsamad@alsheikhagroup.qa',
    'ashraf.alsuhaili@alsheikhagroup.qa',
    'vikas@alsheikhagroup.qa'
  ];
}

// Any restricted dashboard role.
function isStaff() {
  return isAccountant() || isSecretary() || isSupervisor();
}

// May open an employee profile and edit it, but never the salary field.
function isProfileEditor() {
  return isSecretary() || isSupervisor();
}

// True when an update leaves the salary exactly as it was. Uses get() with a
// default so a document that has no salary field yet does not fail the rule.
function salaryUnchanged() {
  return request.resource.data.get('salary', 0) == resource.data.get('salary', 0);
}

// -----------------------------------------------------------------------------
// VIEWERS — balances.html only, READ ONLY, and only three collections.
// -----------------------------------------------------------------------------
// These two people open balances.html to see the bank / delivery / cash figures
// and NOTHING else. A page with no buttons is not protection on its own: any
// email/password account used to be a full admin here, so they could simply
// open admin.html and change payroll. That is why the restriction lives in
// these rules and not only in the page.
//
// Consequences of being on this list, enforced server-side:
//   • READ  only settings, sales_reports and financial_payments — exactly what
//     the three balances are computed from.
//   • NO write, update or delete anywhere, ever.
//   • NO access at all to employees, salaries, attendance, deductions, QID
//     photos, warnings, leave requests, audit log or training records.
//
// The email must match EXACTLY the account created in
// Firebase Console > Authentication > Users. Create the accounts with these
// exact addresses — if an account is created with a different address it is
// NOT on this list and would be treated as a full admin instead.
function isViewer() {
  return isRealLogin() && request.auth.token.email in [
    'houti.anes@alsheikhagroup.qa',
    'fatima.alrumaihi@alsheikhagroup.qa'
  ];
}

// The OWNER: a real email/password login that is on none of the restricted
// lists. Only this account has full access to everything.
function isAdmin() {
  return isRealLogin() && !isViewer() && !isStaff();
}

function isKiosk() {
  return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- employees --------------------------------------------------------
    // Salaries are readable by all four roles by management's decision.
    // Creating: the secretary and supervisors accept new applications, so they
    // may create — but only at salary 0, which the owner or accountant then
    // sets. Updating: they may edit the profile as long as the salary is
    // untouched. Deleting is the owner's alone, since it removes the record.
    match /employees/{empId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow create: if isAdmin()
                    || (isProfileEditor() && request.resource.data.get('salary', 0) == 0);
      allow update: if isAdmin() || isAccountant()
                    || (isProfileEditor() && salaryUnchanged());
      allow delete: if isAdmin();
    }

    // ---- employee_pins ------------------------------------------------------
    // The PIN is part of the profile, so whoever edits profiles sets it.
    match /employee_pins/{empId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow write: if isAdmin() || isProfileEditor();
    }

    // ---- deductions (dated deduction-day entries) ----------------------------
    // Read is granted to every role so the payroll table they can already see
    // shows the CORRECT net salary. Without it the deductions would silently
    // come back empty and the screen would display an inflated figure, which is
    // worse than showing nothing. Writing stays with the owner and accountant.
    // The secretary issues warning letters and, by management's rule, a warning
    // deducts from salary automatically. She therefore needs to write a
    // deduction — but ONLY one carrying source:'warning'. She cannot create a
    // free-form salary deduction, and cannot edit an existing one at all.
    // Delete is allowed on the same narrow condition because removing a warning
    // letter removes its linked deduction.
    match /deductions/{deductionId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAdmin() || isAccountant()
                    || (isSecretary() && request.resource.data.get('source', '') == 'warning');
      allow update: if isAdmin() || isAccountant();
      allow delete: if isAdmin() || isAccountant()
                    || (isSecretary() && resource.data.get('source', '') == 'warning');
    }

    // ---- attendance ---------------------------------------------------------
    // The accountant needs it for payroll, the supervisors for their daily work.
    // The secretary was not given attendance. Corrections are payroll-affecting,
    // so only the owner and accountant may edit or delete a log.
    match /attendance/{logId} {
      allow read: if isAdmin() || isAccountant() || isSupervisor() || isKiosk();
      allow create: if isAdmin() || isKiosk();
      allow update, delete: if isAdmin() || isAccountant();
    }

    // ---- leave_requests -------------------------------------------------------
    // The secretary and the supervisors handle these; the accountant does not.
    match /leave_requests/{reqId} {
      allow read: if isAdmin() || isProfileEditor();
      allow create: if isKiosk() || isAdmin() || isProfileEditor();
      allow update, delete: if isAdmin() || isProfileEditor();
    }

    // ---- employee_applications (self-registration by new hires from the
    // index.html kiosk page) ---------------------------------------------------
    // Kiosk (any visitor) can submit a new application, but can never read
    // the list back (so one applicant can't browse everyone else's QID
    // photos/phone numbers) and can never update/delete once submitted.
    // Only the admin dashboard can review, approve, or reject.
    // The secretary and supervisors review and approve them; the accountant
    // has no access to applicants' QID photos and phone numbers.
    match /employee_applications/{appId} {
      allow read: if isAdmin() || isProfileEditor();
      allow create: if isKiosk() || isAdmin() || isProfileEditor();
      allow update, delete: if isAdmin() || isProfileEditor();
    }

    // ---- branch_geofences ---------------------------------------------------
    // Read so the branch dropdowns fill in; only the owner moves a geofence.
    match /branch_geofences/{branchId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- settings ------------------------------------------------------------
    // Holds financial_rates, cash_account (opening balances), salary_payouts and
    // cash_movements, plus the legacy single geofence doc if still present.
    // Viewers may READ (balances.html needs these four docs) but never write.
    match /settings/{docId} {
      allow read: if isAdmin() || isStaff() || isKiosk() || isViewer();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- employee_warnings (Warning Letters tab) ----------------------------
    // The secretary's job. The accountant and supervisors have no access.
    match /employee_warnings/{warnId} {
      allow read, write: if isAdmin() || isSecretary();
    }

    // ---- annual_leaves ------------------------------------------------------
    // Granted to the accountant because a leave writes a 21-day deduction plus
    // two 750 allowances straight into the payroll he has to reconcile.
    // Readable by the others so the payroll figures they see stay correct.
    match /annual_leaves/{leaveId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- allowance_payments (linked leave/ticket allowance payouts created
    // automatically when an Annual Leave is saved — tied to annual_leaves, so
    // the same access applies) ----------------------------------------------
    match /allowance_payments/{paymentId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- admin_users (legacy collection from the old role system — no
    // longer used by the app, kept locked down in case old docs linger) -----
    match /admin_users/{uid} {
      allow read, write: if isAdmin();
    }

    // ---- audit_log (read-only trail of key mutating actions — admin-only
    // read/create, NO update/delete allowed for anyone, keeping the log
    // immutable/tamper-resistant once written) -------------------------------
    // Every role may CREATE an entry, otherwise their actions would go
    // unrecorded and the trail would only cover the owner — defeating its
    // purpose now that five people can change data. Only the owner READS it.
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isStaff();
      allow update, delete: if false;
    }

    // ---- training_content (the daily work guide/protocol text+images per
    // restaurant+department, doc id = {RESTAURANT}__{DEPARTMENT}) -----------
    // The kiosk (Employee Training tab) only ever needs to READ this to show
    // it to the employee; only the admin dashboard's Training Content editor
    // ever writes it.
    match /training_content/{docId} {
      allow read: if isAdmin() || isStaff() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- training_acknowledgments (permanent proof an employee confirmed
    // reading the training guide) --------------------------------------------
    // The kiosk creates one on each confirmation (and re-reads its own
    // history to show the "already confirmed" banner isn't strictly needed
    // server-side, but allowing isKiosk() read here keeps that banner
    // working without a separate admin-only round trip). Only the admin
    // dashboard's Training Records view otherwise reads these. NO update/
    // delete for anyone — this must stay a permanent, tamper-resistant audit
    // trail, exactly like audit_log above.
    match /training_acknowledgments/{ackId} {
      allow read: if isAdmin() || isKiosk();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if false;
    }

    // ---- petty_cash_requests (a branch manager asks for cash from the
    // managers-only screen in index.html) -------------------------------------
    // Same blind-submit pattern as sales_reports: the kiosk may CREATE but can
    // never read one back, so a manager cannot browse other branches' requests
    // or see the amounts they asked for. The accountant reviews and approves,
    // which is what turns it into a variable expense.
    match /petty_cash_requests/{reqId} {
      allow read: if isAdmin() || isAccountant();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if isAdmin() || isAccountant();
    }

    // ---- warning_requests (a branch manager asks the secretary to issue a
    // warning letter for an employee) ----------------------------------------
    // Blind submit as above. Only the secretary and the owner see them; the
    // accountant has no reason to read staff discipline cases.
    match /warning_requests/{reqId} {
      allow read: if isAdmin() || isSecretary();
      allow create: if isKiosk() || isAdmin();
      allow update, delete: if isAdmin() || isSecretary();
    }

    // ---- financial_months (one doc per closed month, id = 'YYYY-MM') --------
    // Holds the frozen snapshot of a month's financial figures once management
    // closes it, so a past month can never be silently recalculated by a later
    // salary edit or employee deletion. Admin-only in both directions: the
    // kiosk has no reason to read or write an accounting record.
    // The accountant closes the month, so he needs both read and write here.
    match /financial_months/{monthId} {
      allow read, write: if isAdmin() || isAccountant();
    }

    // ---- financial_payments (the fixed/variable payment lines that feed the
    // Monthly Financial Report tab in the admin dashboard) -------------------
    // Admin-only in BOTH directions. Unlike sales_reports the kiosk has no
    // reason to even create these: rent, salaries and purchase figures are
    // entered by management on the dashboard, never from the employee page.
    // Viewers may READ these (money going out is part of the balance) but can
    // never add, change or delete a payment.
    match /financial_payments/{paymentId} {
      allow read: if isAdmin() || isAccountant() || isViewer();
      allow write: if isAdmin() || isAccountant();
    }

    // ---- sales_reports (the Daily Sales Report a branch manager submits from
    // the managers-only #report screen in index.html) ------------------------
    // The kiosk page may CREATE a report but can NEVER read one back. Sales
    // figures are commercially sensitive and index.html is signed in
    // ANONYMOUSLY, so granting it read access here would expose every branch's
    // revenue to anyone who can open that page. Managers therefore submit
    // "blind" and only get a confirmation message; the figures are readable
    // exclusively from the admin dashboard's Daily Report tab.
    // Update is admin-only as well: a manager who mistyped simply submits
    // again, and the admin deletes the wrong entry — this also means a
    // malicious anonymous caller cannot overwrite a real report it cannot read.
    // Viewers may READ these (money coming in is part of the balance) but can
    // never submit, change or delete a report.
    // v10: the three branch supervisors (Bilal, Ashraf, Vikas) may now READ and
    // CORRECT a daily report, by management's decision — they are the ones who
    // submitted it and who notice a wrong figure first. They may NOT delete one:
    // a mistyped report is fixed by correcting it, and deleting the money that
    // came in is a different act reserved for the owner and the accountant.
    match /sales_reports/{reportId} {
      allow read: if isAdmin() || isAccountant() || isViewer() || isSupervisor();
      allow update: if isAdmin() || isAccountant() || isSupervisor();
      allow delete: if isAdmin() || isAccountant();
      allow create: if isKiosk() || isAdmin();
    }

    // =========================================================================
    // THE ABAYA SHOPS — Al Sheikha Style
    // -------------------------------------------------------------------------
    // A SEPARATE business from the restaurants. Three shops: Gulf Mall,
    // Vendome Mall, Doha Festival City.
    //
    // ⚠️ Why separate collections and not the existing employees/sales_reports?
    // Because sharing them would silently corrupt the restaurants:
    //   • abaya money would enter the restaurants' Daily Report, the Monthly
    //     Financial report, the three balances and the Daily Target;
    //   • the saleswomen would appear in restaurant attendance and payroll.
    // The owner asked for the two businesses never to touch. These rules are
    // where that guarantee actually lives — hiding a tab does not enforce it.
    //
    // Access: the OWNER and the ACCOUNTANT only. NOT the supervisors (Bilal,
    // Ashraf, Vikas), NOT the secretary, and NOT the viewers of balances.html.
    // =========================================================================

    // ---- abaya_sellers (the saleswomen: name only, no salary, no documents) --
    // The seller panel (abaya-seller.html) is signed in ANONYMOUSLY and needs
    // to READ this list to fill its dropdown. Nothing sensitive lives here —
    // only a display name — which is exactly why the list is a separate
    // collection instead of a flag on an employee record.
    // Only the owner may add or remove a seller.
    match /abaya_sellers/{sellerId} {
      allow read: if isAdmin() || isAccountant() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- abaya_seller_pins --------------------------------------------------
    // Same shape and the same trade-off as employee_pins: the panel has no
    // backend, so it must read the PIN to compare it in the browser. The PIN
    // is therefore a convenience gate, not a secret — the real protections are
    // these rules plus Firebase App Check. Kept in its own collection so a
    // future backend can lock reads away without touching the seller list.
    match /abaya_seller_pins/{sellerId} {
      allow read: if isAdmin() || isAccountant() || isKiosk();
      allow write: if isAdmin();
    }

    // ---- abaya_sales_reports (the daily report a saleswoman submits) ---------
    // Submit-blind, exactly like sales_reports: the panel may CREATE a report
    // but can NEVER read one back. It is signed in anonymously, so read access
    // would expose every shop's revenue to anyone who opens that page. She gets
    // a confirmation summary built from what she just typed, not from a query.
    //
    // The report also carries what is OWED TO SHANTON (the designer whose
    // abayas are sold on consignment for a fixed 200 QAR commission per piece).
    // That is a liability figure, one more reason it is not world-readable.
    //
    // Correcting and deleting stay with the owner and the accountant — the same
    // split as the restaurants' reports, minus the supervisors who have no part
    // in this business.
    match /abaya_sales_reports/{reportId} {
      allow read: if isAdmin() || isAccountant();
      allow update: if isAdmin() || isAccountant();
      allow delete: if isAdmin() || isAccountant();
      allow create: if isKiosk() || isAdmin();
    }

    // NOTE: the abaya settings documents (settings/abaya_rates for the card fee
    // and Shanton's per-piece commission, settings/abaya_stock_opening for the
    // opening stock count of each shop) need NO rule of their own — they live
    // inside the settings collection already covered above, which the panel may
    // read and the owner and accountant may write.

    // ---- Default deny for anything not explicitly listed above ---------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
